# ==============================================================================
# Drone CI Environment Configuration Template
# Copy this file to .env and fill in your actual GitHub OAuth credentials.
# DO NOT commit your actual .env file to Git!
# ==============================================================================

# GitHub OAuth Application Credentials
# Generate at: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
DRONE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here
DRONE_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Shared secret between Drone Server and Drone Docker Runner
# Generate with: openssl rand -hex 16
DRONE_RPC_SECRET=your_shared_rpc_secret_here

# Public Host and Protocol for Drone Server
# For local development with a tunnel (e.g. ngrok):
# DRONE_SERVER_HOST=your-tunnel-subdomain.ngrok-free.app
# DRONE_SERVER_PROTO=https
# For local network testing:
DRONE_SERVER_HOST=localhost:8000
DRONE_SERVER_PROTO=http

# Initial Admin Username (matches your GitHub username)
DRONE_ADMIN_USER=your_github_username
